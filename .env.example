# Prediqo — example environment configuration
# Copy to .env and fill in locally. NEVER commit the filled .env file.

# --- Global ---
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=Prediqo
API_V1_PREFIX=/api/v1

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- PostgreSQL ---
POSTGRES_DB=prediqo
POSTGRES_USER=prediqo
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Firebase (server-side) ---
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json

# --- Auth mode ---
# firebase = verify real Firebase ID tokens (required outside development)
# dev      = accept DEV_AUTH_TOKEN, only when ENVIRONMENT=development
AUTH_MODE=firebase
DEV_AUTH_TOKEN=prediqo-dev-token
# Optional: point the backend at SQLite for local development without Postgres
# DATABASE_URL=sqlite+aiosqlite:///C:/path/to/prediqo-dev.db

# --- Sports data provider (server-side only) ---
FOOTBALL_DATA_PROVIDER=api-football
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://v3.football.api-sports.io

# --- Google Play Billing ---
GOOGLE_PLAY_PACKAGE_NAME=com.prediqo.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_POLL_INTERVAL_MINUTES=15

# --- AdMob (client config supplied via remote config, IDs only) ---
ADMOB_ENABLED=false
ADMOB_APP_ID=
ADMOB_BANNER_UNIT_ID=
ADMOB_INTERSTITIAL_UNIT_ID=
ADMOB_REWARDED_UNIT_ID=
ADMOB_APP_OPEN_UNIT_ID=

# --- ML / model registry ---
MLFLOW_TRACKING_URI=file:./mlruns
MODEL_ARTIFACT_PATH=./model_artifacts

# --- Limits (TO BE CONFIRMED by product owner) ---
FREE_DAILY_PREDICTIONS=3
FREE_DAILY_ANALYSIS=1
TOKEN_UNLOCK_COST_FULL_REPORT=5
VIP_MONTHLY_PRICE_MINOR=49900
VIP_CURRENCY=KES

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Observability ---
LOG_LEVEL=INFO
SENTRY_DSN=
